{
  "public": "dist",
  "rewrites": [
    {
      "source": "/loja/*",
      "destination": "/index.html"
    },
    {
      "source": "/loja",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "**/*.@(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
} 